<?xml version="1.0"?>
<sdf version="1.10">
  <model name="apriltag36h11_00000">
    <static>true</static>
    <link name="panel">
      <!-- Visual only, deliberately: this is a detection target, not an obstacle.
           Giving it a collision would turn it into something Nav2's costmap has to
           route around, which has nothing to do with what we're validating here. -->
      <visual name="tag_face">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.6 0.6</size>
          </plane>
        </geometry>
        <material>
          <!-- No flat ambient/diffuse/specular here on purpose: setting those to a
               bright color on top of an albedo map washed the tag's black cells out
               to mid-gray (confirmed by rendering a frame and zooming in - the "black"
               border came out as flat grey, not the near-black of the source PNG).
               Let the albedo map alone drive the colour. -->
          <pbr>
            <metal>
              <!-- Absolute path, deliberately. A relative "materials/textures/..."
                   path logged no resolve error but rendered the panel solid black
                   (texture silently not applied); the absolute form is what actually
                   renders the marker here. Machine-specific, which is acceptable only
                   because this whole directory is a local test fixture, never shipped. -->
              <albedo_map>/home/keba/PAN/ros2_ws/src/solutions/test_assets/models/apriltag36h11_00000/materials/textures/tag36h11_00000.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
